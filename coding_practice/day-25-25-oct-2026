# Terraform -create cloudwatch
resource "aws_cloudwatch_metric_alaram" "pahtnex_cpu_alaram"{
alarm_name     ="pathnex-cpu-utilization"
comparison_operator="GreaterthanThereshold"
evalustion_periods ="1"
metric_name     ="cpuutilazation
namespace  ="aws/ec2"
period   ="60"
stasticstic  "average"
dimensions{
InstancId=aws_instance.pathnex
}
alarm_actions=[aws_sns_topic.pathnex_alert.arn]
}


resource "aws_sns_topic" "pathnex_alerts" {
  name = "pathnex-alerts"
}



