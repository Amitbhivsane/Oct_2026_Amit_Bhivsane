#terraform  api gateway with lambda integration

resource "aws_api_gateway_rest_api" "pathnex_api"{
  name        ="pahtnex-api"
  description ="Pathenx_api"
}

resource "aws_api+lambda_function" "pathnex_lambda"{
 
  function_name ="pathnex-lambda
  runtime       ="python3.8"
  role          =aws_iam_roel.lambda_exc_role_arn
  handler	="lambda_function.lambdat_handler"
  filename      ="lambda.zip"
}

resource "aws_api_gateway_intergration""lambda_intergration"{
  rest_api_id =aws_api_gateway_reat_api.pathnex.id
  resource_id=aws_api_gateway_resource_id
  http_methods=aws_api_gateway_method.pathnex_method.http_method

type="aws_PROXY"
uri =aws_lambda_function.pathnex_lambdat.invoke_Arn
} 



