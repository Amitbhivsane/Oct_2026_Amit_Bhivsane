# Ansible SSH key based authentication

-name: Implement SSH key Authentication
 hosts: all
 become: yes
 tasks:
    -name: Generate SHH key pair
     command: ssh-keygen -t rsa -b 2024 /home/user/is_rsa
     name: Add SHHP public key to authorized_keys
     authorized_key:
           user: user
           state: present
           key : "{{lookup("file", /home/user/.shh/id_rsa)}}"



