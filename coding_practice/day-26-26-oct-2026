#kubernates 

apiVersion: networking.k8.io/v1
kind: networking policy
metadata:
   name: pathnex-web-policy
   spec:
     podSelector:
         matchLabels:
             app: pathnex-web-app
           policyTypes:
              -ingress
               -Egress
              ingress:
                -from:
                   -podSelector:
                      matchLabels:
                        app: pathnex-api
           egress :
                -to:
                  -podSelector:
                     matchLabels:
                        app: pathnex-database


