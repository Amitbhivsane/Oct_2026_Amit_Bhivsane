name: Install Docker
hosts: all
become: yes
tasks:
   name: Install Docker
   yum:
      name: docker
      state: present
     name: Start Docker
     service:
        name: docker
        state: started
        enabled: yes

resource "aws_instance"" "Pathnex_ec2"{
 ami           = "ami-0abcd1234abcd1234"
 instance_type = "t3.medium"
  subnet_id     = aws_subnet.main.id
  tags = {
    Name = "Pathnex-EC2"
  }
}


apiVersion: v1
kind: Pod
metadata:
   name: pathnex-pod
 spec:
  container:
      name: web
      image: ngonix
      volumeMounts:
         mountPath: /user/share/nginx/html
         name: htm-volume

volumes:
   name: html-volume
   hostPath:
     path: /data
     type: Directory

#!/bin/bash

services=("nginx" "docker" "httpd")
for service in "${service[@]}"
do
   if systemctl is-active   
      echo "$service is running"
   else
      echo "service is not running"
    fi
 done


#Docker
consloe.log("hello pathnex")

FROM node:18
WORKDIR /opt.pathnex/node-app
COPY app.js /opt/pathnex/node-app/
CMD ["node", "/opt/pathnex/node-app/app.js"
   
