name: install Prometheus for monitoring 
hosts: all
become: yes
tasks: 
   name: Install Prometheus dependencies
    yum:
     name: 
        Prometheus
        prometheus-node-exporter
        states: present
       name: Start Prometheus service
       service:
           name: Prometheus
           state: started
           enabled: yes


