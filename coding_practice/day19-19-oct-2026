 stages:
    build:
    push
    deploy

 
build:
  stage: build
  script:
      docker build -t pathnex-web-app
 
push:
  stage: push
  script: 
     docker login -u "$CI_REGISTERY_USER" -p "$CI_REGISTERY_PASSWORD"
      docker push pathnex-web-app


deploy:
  stage: deploy
  script: 
    kubectel appy -f kubernates/deployment.yaml
    kubectl get pods ---watch


